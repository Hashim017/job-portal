@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => ctrl == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobPortal</title>
    <script>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg nav-glass sticky-top">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-briefcase-fill"></i> JobPortal
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @Active("Jobs")" asp-controller="Jobs" asp-action="Index">Browse jobs</a>
                        </li>
                        @if (User.IsInRole("Employer"))
                        {
                        <li class="nav-item">
                            <a class="nav-link @Active("EmployerJobs")" asp-controller="EmployerJobs" asp-action="Index">My jobs</a>
                        </li>
                        }
                        @if (User.IsInRole("JobSeeker"))
                        {
                        <li class="nav-item">
                            <a class="nav-link @Active("Applications")" asp-controller="Applications" asp-action="Index">My applications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("SavedJobs")" asp-controller="SavedJobs" asp-action="Index">Saved</a>
                        </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                        <li class="nav-item">
                            <a class="nav-link @Active("Admin")" asp-controller="Admin" asp-action="Index">Admin</a>
                        </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                        <li class="nav-item">
                            <a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-grid"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
                                <span class="avatar avatar-sm">@UiHelper.Initial(User.Identity!.Name)</span>
                                <span class="d-lg-none d-xl-inline">@User.Identity!.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-grid me-2"></i>Dashboard
                                    </a>
                                </li>
                                @if (User.IsInRole("JobSeeker"))
                                    {
                                <li>
                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                        <i class="bi bi-person-badge me-2"></i>My profile
                                    </a>
                                </li>
                                    }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Log out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                        }
                        else
                        {
                        <li class="nav-item">
                            <a class="nav-link @Active("Account")" asp-controller="Account" asp-action="Login">Log in</a>
                        </li>
                        <li class="nav-item ms-lg-1">
                            <a class="btn btn-brand" asp-controller="Account" asp-action="Register">Get started</a>
                        </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 py-4">
            <span class="brand-mark"><i class="bi bi-briefcase-fill"></i> JobPortal</span>
            <span class="text-muted small">Connecting talent with opportunity.</span>
        </div>
    </footer>

    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        @if (TempData["Success"] != null)
        {
        <div class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
        }
        @if (TempData["Error"] != null)
        {
        <div class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>