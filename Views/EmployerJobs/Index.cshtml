@model List<Job>
    @{
    ViewData["Title"] = "My jobs";
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 reveal">
        <div>
            <h2 class="mb-0">My jobs</h2>
            <p class="text-muted mb-0">@Model.Count posted</p>
        </div>
        <a asp-action="Create" class="btn btn-brand"><i class="bi bi-plus-lg"></i> Post a job</a>
    </div>

    @if (!Model.Any())
{
    <div class="empty-state reveal">
        <i class="bi bi-briefcase"></i>
        <h5 class="mt-2">No jobs yet</h5>
        <p class="text-muted">Post your first job and start receiving applications.</p>
        <a asp-action="Create" class="btn btn-brand">Post a job</a>
    </div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var job in Model)
        {
        <div class="reveal">
            <div class="card-soft p-3 p-md-4">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <h5 class="mb-0">@job.Title</h5>
                            @if (job.IsOpen)
                                {
                            <span class="status-badge status-open">Open</span>
                                }
                                else
                                {
                            <span class="status-badge status-closed">Closed</span>
                                }
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="chip"><i class="bi bi-geo-alt"></i> @job.Location</span>
                            <span class="chip"><i class="bi bi-clock"></i> @job.JobType.Label()</span>
                            <span class="chip"><i class="bi bi-calendar3"></i> @job.CreatedAt.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>

                    <a asp-action="Applicants" asp-route-id="@job.Id" class="btn btn-outline-primary">
                        <i class="bi bi-people"></i> Applicants
                        <span class="badge bg-primary rounded-pill">@job.Applications.Count</span>
                    </a>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Toggle" asp-route-id="@job.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(job.IsOpen ? "Close" : "Reopen")</button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@job.Id" method="post"
                              onsubmit="return confirm('Delete this job and its applications?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
}
