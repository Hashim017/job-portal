@using JobPortal.Models
@model List<Job>
    @{
    ViewData["Title"] = "My jobs";
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">My jobs</h2>
        <a asp-action="Create" class="btn btn-primary">Post a job</a>
    </div>

    @if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

    @if (!Model.Any())
{
    <p class="text-muted">You have not posted any job yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Posted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model)
                {
                <tr>
                    <td>@job.Title</td>
                    <td>@job.JobType.Label()</td>
                    <td>@job.Location</td>
                    <td>
                        @if (job.IsOpen)
                            {
                        <span class="badge bg-success">Open</span>
                            }
                            else
                            {
                        <span class="badge bg-secondary">Closed</span>
                            }
                    </td>
                    <td>@job.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-action="Toggle" asp-route-id="@job.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(job.IsOpen ? "Close" : "Reopen")</button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@job.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this job?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
}
