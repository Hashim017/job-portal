@model JobPortal.ViewModels.LoginViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = "Log in";
    var showDemo = string.Equals(Config["SeedDemoData"], "true", StringComparison.OrdinalIgnoreCase);
}

<div class="auth-wrap reveal">
    <div class="row g-0 auth-card">
        <div class="col-lg-5 auth-side d-none d-lg-flex">
            <div>
                <i class="bi bi-briefcase-fill auth-icon"></i>
                <h2 class="mt-3">Welcome back</h2>
                <p class="opacity-75">Log in to track applications, post jobs and manage your hiring.</p>
                <ul class="auth-points">
                    <li><i class="bi bi-check2-circle"></i> One click apply</li>
                    <li><i class="bi bi-check2-circle"></i> Live application status</li>
                    <li><i class="bi bi-check2-circle"></i> Simple hiring tools</li>
                </ul>
            </div>
        </div>
        <div class="col-lg-7 p-4 p-md-5">
            <h3 class="mb-1">Log in</h3>
            <p class="text-muted mb-4">Enter your details to continue.</p>

            <form id="loginForm" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-brand w-100 py-2">Log in</button>
            </form>

            @if (showDemo)
            {
            <div class="demo-box mt-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-lightning-charge-fill"></i>
                    <strong>Quick demo login</strong>
                </div>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <button type="button" class="demo-btn" data-email="seeker1@demo.com" data-pass="Demo@12345">
                            <i class="bi bi-person-workspace"></i>
                            <span><strong>Job seeker</strong><small>seeker1@demo.com</small></span>
                        </button>
                    </div>
                    <div class="col-sm-6">
                        <button type="button" class="demo-btn" data-email="employer1@demo.com" data-pass="Demo@12345">
                            <i class="bi bi-building"></i>
                            <span><strong>Employer</strong><small>employer1@demo.com</small></span>
                        </button>
                    </div>
                </div>
                <div class="text-muted small mt-2">Password for both: Demo@12345. Click a card to log in.</div>
            </div>
            }
            <p class="mt-4 mb-0 text-center text-muted">
                New here? <a asp-action="Register" class="fw-semibold text-decoration-none">Create an account</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.demo-btn').forEach(function (b) {
            b.addEventListener('click', function () {
                document.getElementById('Email').value = b.getAttribute('data-email');
                document.getElementById('Password').value = b.getAttribute('data-pass');
                document.getElementById('loginForm').submit();
            });
        });
    </script>
}