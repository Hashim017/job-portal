@model JobPortal.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrap reveal">
    <div class="row g-0 auth-card">
        <div class="col-lg-5 auth-side d-none d-lg-flex">
            <div>
                <i class="bi bi-rocket-takeoff auth-icon"></i>
                <h2 class="mt-3">Start in a minute</h2>
                <p class="opacity-75">Create a free account to apply for jobs or to hire great people.</p>
                <ul class="auth-points">
                    <li><i class="bi bi-check2-circle"></i> Free to join</li>
                    <li><i class="bi bi-check2-circle"></i> Track every application</li>
                    <li><i class="bi bi-check2-circle"></i> Post jobs and review applicants</li>
                </ul>
            </div>
        </div>
        <div class="col-lg-7 p-4 p-md-5">
            <h3 class="mb-1">Create account</h3>
            <p class="text-muted mb-4">Choose how you will use JobPortal.</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="row g-3 mb-1">
                    <div class="col-6">
                        <label class="role-option">
                            <input type="radio" asp-for="Role" value="JobSeeker" id="roleSeeker" />
                            <span class="role-card">
                                <i class="bi bi-person-workspace"></i>
                                <strong>Job seeker</strong>
                                <small>Find and apply for jobs</small>
                            </span>
                        </label>
                    </div>
                    <div class="col-6">
                        <label class="role-option">
                            <input type="radio" asp-for="Role" value="Employer" id="roleEmployer" />
                            <span class="role-card">
                                <i class="bi bi-building"></i>
                                <strong>Employer</strong>
                                <small>Post jobs and hire</small>
                            </span>
                        </label>
                    </div>
                </div>
                <span asp-validation-for="Role" class="text-danger"></span>

                <div class="mb-3 mt-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3" id="companyBox">
                    <label asp-for="CompanyName" class="form-label"></label>
                    <input asp-for="CompanyName" class="form-control" />
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-brand w-100 py-2">Create account</button>
            </form>

            <p class="mt-4 mb-0 text-center text-muted">
                Have an account? <a asp-action="Login" class="fw-semibold text-decoration-none">Log in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const roleInputs = document.querySelectorAll('input[name="Role"]');
        const companyBox = document.getElementById("companyBox");
        function toggleCompany() {
            const chosen = document.querySelector('input[name="Role"]:checked');
            companyBox.style.display = chosen && chosen.value === "Employer" ? "block" : "none";
        }
        roleInputs.forEach(function (r) { r.addEventListener("change", toggleCompany); });
        toggleCompany();
    </script>
}