@model JobPortal.ViewModels.AdminJobsViewModel
@{
    ViewData["Title"] = "Admin jobs";
}

<div class="reveal mb-3">
    <h2 class="mb-1">Jobs</h2>
    <p class="text-muted">@Model.Jobs.Count shown</p>
</div>

<partial name="_AdminTabs" />

<form method="get" class="card-soft filter-bar mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Title, company or city" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All</option>
                <option value="open" selected="@(Model.Status == "open")">Open</option>
                <option value="closed" selected="@(Model.Status == "closed")">Closed</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-brand"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Jobs" class="btn btn-light">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Jobs.Any())
{
<div class="empty-state reveal">
    <i class="bi bi-briefcase"></i>
    <h5 class="mt-2">No jobs found</h5>
    <p class="text-muted mb-0">Try a different search.</p>
</div>
}
else
{
<div class="card-soft reveal">
    @foreach (var job in Model.Jobs)
        {
    <div class="list-row">
        <div class="logo-badge">@UiHelper.Initial(job.Employer.CompanyName)</div>
        <div class="flex-grow-1">
            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="fw-bold text-decoration-none text-reset">@job.Title</a>
            <div class="text-muted small">@job.Employer.CompanyName · @job.Location · @UiHelper.TimeAgo(job.CreatedAt)</div>
        </div>
        <span class="chip"><i class="bi bi-people"></i> @job.Applications.Count</span>
        <span class="status-badge @(job.IsOpen ? "status-open" : "status-closed")">@(job.IsOpen ? "Open" : "Closed")</span>
        <div class="d-flex gap-2">
            <form asp-action="ToggleJob" asp-route-id="@job.Id" method="post">
                <button type="submit" class="btn btn-sm btn-outline-secondary">@(job.IsOpen ? "Close" : "Reopen")</button>
            </form>
            <form asp-action="DeleteJob" asp-route-id="@job.Id" method="post"
                  onsubmit="return confirm('Delete this job and its applications?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        </div>
    </div>
        }
</div>
}