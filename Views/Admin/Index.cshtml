@model JobPortal.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin";
}

<div class="dash-head reveal mb-3">
    <p class="mb-1 opacity-75">Admin dashboard</p>
    <h2 class="mb-0">Platform overview</h2>
</div>

<partial name="_AdminTabs" />

<div class="row g-3">
    <div class="col-6 col-lg-4">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-brand"><i class="bi bi-people"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.TotalUsers">0</div>
                <div class="stat-label">Total users</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-teal"><i class="bi bi-person-workspace"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.JobSeekers">0</div>
                <div class="stat-label">Job seekers</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-amber"><i class="bi bi-building"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.Employers">0</div>
                <div class="stat-label">Employers</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-brand"><i class="bi bi-briefcase"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.TotalJobs">0</div>
                <div class="stat-label">Total jobs</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-green"><i class="bi bi-broadcast"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.OpenJobs">0</div>
                <div class="stat-label">Open jobs</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-red"><i class="bi bi-send-check"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.TotalApplications">0</div>
                <div class="stat-label">Applications</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="card-soft reveal h-100">
            <div class="d-flex justify-content-between align-items-center p-3 px-4 border-bottom">
                <h5 class="mb-0">Latest jobs</h5>
                <a asp-action="Jobs" class="fw-semibold text-decoration-none">Manage</a>
            </div>
            @if (!Model.RecentJobs.Any())
            {
            <div class="p-4 text-center text-muted">No jobs yet.</div>
            }
            else
            {
            @foreach (var j in Model.RecentJobs)
                {
            <div class="list-row">
                <div class="logo-badge">@UiHelper.Initial(j.Employer.CompanyName)</div>
                <div class="flex-grow-1">
                    <div class="fw-bold">@j.Title</div>
                    <div class="text-muted small">@j.Employer.CompanyName · @UiHelper.TimeAgo(j.CreatedAt)</div>
                </div>
                <span class="status-badge @(j.IsOpen ? "status-open" : "status-closed")">@(j.IsOpen ? "Open" : "Closed")</span>
            </div>
                }
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card-soft reveal h-100">
            <div class="d-flex justify-content-between align-items-center p-3 px-4 border-bottom">
                <h5 class="mb-0">Latest applications</h5>
            </div>
            @if (!Model.RecentApplications.Any())
            {
            <div class="p-4 text-center text-muted">No applications yet.</div>
            }
            else
            {
            @foreach (var a in Model.RecentApplications)
                {
            <div class="list-row">
                <div class="avatar">@UiHelper.Initial(a.Applicant.FullName)</div>
                <div class="flex-grow-1">
                    <div class="fw-bold">@a.Applicant.FullName</div>
                    <div class="text-muted small">applied to @a.Job.Title · @UiHelper.TimeAgo(a.AppliedAt)</div>
                </div>
                <span class="status-badge @a.Status.CssClass()">@a.Status</span>
            </div>
                }
            }
        </div>
    </div>
</div>