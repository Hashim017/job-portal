@model JobPortal.Models.ApplicationUser
@{
    ViewData["Title"] = "Employer dashboard";
}

<h2 class="mb-1">Welcome, @Model.FullName</h2>
<p class="text-muted">Employer account for @Model.CompanyName.</p>

<div class="row g-3 mt-2">
    <div class="col-md-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <h1 class="display-5">@ViewBag.ActiveJobs</h1>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <h1 class="display-5">0</h1>
                <p class="mb-0">Total applicants</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <h1 class="display-5">0</h1>
                <p class="mb-0">Shortlisted</p>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">My job posts</h5>
        <p class="text-muted mb-0">You have not posted any job yet.</p>
    </div>
</div>