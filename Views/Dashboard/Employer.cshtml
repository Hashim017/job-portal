@model JobPortal.ViewModels.EmployerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dash-head reveal">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <p class="mb-1 opacity-75">Employer dashboard</p>
            <h2 class="mb-0">@Model.Profile.CompanyName</h2>
            <p class="mb-0 opacity-75">Welcome, @Model.Profile.FullName</p>
        </div>
        <a asp-controller="EmployerJobs" asp-action="Create" class="btn btn-light"><i class="bi bi-plus-lg"></i> Post a job</a>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-6 col-lg-3">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-green"><i class="bi bi-broadcast"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.ActiveJobs">0</div>
                <div class="stat-label">Active jobs</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-brand"><i class="bi bi-briefcase"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.TotalJobs">0</div>
                <div class="stat-label">Total jobs</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-amber"><i class="bi bi-people"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.TotalApplicants">0</div>
                <div class="stat-label">Applicants</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-teal"><i class="bi bi-star"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.Shortlisted">0</div>
                <div class="stat-label">Shortlisted</div>
            </div>
        </div>
    </div>
</div>

<div class="card-soft mt-4 reveal">
    <div class="d-flex justify-content-between align-items-center p-3 px-4 border-bottom">
        <h5 class="mb-0">Recent applicants</h5>
        <a asp-controller="EmployerJobs" asp-action="Index" class="fw-semibold text-decoration-none">Manage jobs</a>
    </div>
    @if (!Model.RecentApplicants.Any())
    {
    <div class="p-4 text-center text-muted">
        No applicants yet. Post a job to start receiving applications.
    </div>
    }
    else
    {
    @foreach (var a in Model.RecentApplicants)
        {
    <div class="list-row">
        <div class="avatar">@UiHelper.Initial(a.Applicant.FullName)</div>
        <div class="flex-grow-1">
            <div class="fw-bold">@a.Applicant.FullName</div>
            <div class="text-muted small">applied to @a.Job.Title · @UiHelper.TimeAgo(a.AppliedAt)</div>
        </div>
        <span class="status-badge @a.Status.CssClass()">@a.Status</span>
        <a asp-controller="EmployerJobs" asp-action="Applicants" asp-route-id="@a.JobId" class="btn btn-sm btn-outline-primary">Review</a>
    </div>
        }
    }
</div>