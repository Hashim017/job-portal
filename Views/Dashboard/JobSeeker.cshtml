@model JobPortal.ViewModels.JobSeekerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dash-head reveal">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <p class="mb-1 opacity-75">Job seeker dashboard</p>
            <h2 class="mb-0">Hi, @Model.Profile.FullName 👋</h2>
        </div>
        <a asp-controller="Jobs" asp-action="Index" class="btn btn-light"><i class="bi bi-search"></i> Browse jobs</a>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-6 col-lg-3">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-brand"><i class="bi bi-send"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.Total">0</div>
                <div class="stat-label">Applications</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-amber"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.Pending">0</div>
                <div class="stat-label">Pending</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-green"><i class="bi bi-star"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.Shortlisted">0</div>
                <div class="stat-label">Shortlisted</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card reveal">
            <div class="stat-icon bg-soft-red"><i class="bi bi-x-circle"></i></div>
            <div>
                <div class="stat-num" data-count="@Model.Rejected">0</div>
                <div class="stat-label">Rejected</div>
            </div>
        </div>
    </div>
</div>

<div class="card-soft mt-4 reveal">
    <div class="d-flex justify-content-between align-items-center p-3 px-4 border-bottom">
        <h5 class="mb-0">Recent applications</h5>
        <a asp-controller="Applications" asp-action="Index" class="fw-semibold text-decoration-none">View all</a>
    </div>
    @if (!Model.Recent.Any())
    {
    <div class="p-4 text-center text-muted">
        You have not applied to any job yet.
        <a asp-controller="Jobs" asp-action="Index">Browse jobs</a>
    </div>
    }
    else
    {
    @foreach (var a in Model.Recent)
        {
    <div class="list-row">
        <div class="logo-badge">@UiHelper.Initial(a.Job.Employer.CompanyName)</div>
        <div class="flex-grow-1">
            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@a.JobId" class="fw-bold text-decoration-none text-reset">@a.Job.Title</a>
            <div class="text-muted small">@a.Job.Employer.CompanyName · applied @UiHelper.TimeAgo(a.AppliedAt)</div>
        </div>
        <span class="status-badge @a.Status.CssClass()">@a.Status</span>
    </div>
        }
    }
</div>